# Mets UNE de ces clés dans Vercel > Settings > Environment Variables (jamais dans le code).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optionnel : choisir le modèle
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-5-mini
# GEMINI_MODEL=gemini-2.5-flash

